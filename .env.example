# Token del bot (lo entrega @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAExample

# API key de OpenAI
OPENAI_API_KEY=sk-...

# ID del spreadsheet (el que aparece en la URL del Sheet)
GOOGLE_SHEET_ID=1AbC...

# ID de la carpeta de Drive donde se guardan las imágenes (el de la URL de la carpeta)
GDRIVE_FOLDER_ID=1XyZ...

# Credenciales de la service account: usa UNA de las dos opciones.
# Opción A: ruta al archivo JSON
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Opción B: el JSON completo en base64 (base64 -w0 service-account.json)
# GOOGLE_SERVICE_ACCOUNT_B64=

# Opcional: secreto para validar que los webhooks vienen de Telegram
# (debe coincidir con el secret_token pasado a setWebhook)
# TELEGRAM_WEBHOOK_SECRET=

# Opcional: nombre de la hoja dentro del spreadsheet (por defecto, la primera)
# SHEET_WORKSHEET_NAME=

# Opcional: modelo de OpenAI (por defecto gpt-4o)
# OPENAI_MODEL=gpt-4o
